{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Percolume",
  "version": "0.2.0",
  "identifier": "com.percolume.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Percolume",
        "width": 250,
        "height": 350,
        "minWidth": 250,
        "minHeight": 350,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "noRedirectionBitmap": true,
        "shadow": false,
        "alwaysOnTop": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "perMachine", "displayLanguageSelector": true }
    }
  }
}
